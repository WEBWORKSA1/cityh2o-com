<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom"><channel>
<title>CityH2O Guides</title><link>{{ site.url }}/</link><description>{{ site.description | xml_escape }}</description>
<atom:link href="{{ site.url }}/feed.xml" rel="self" type="application/rss+xml"/>
{% assign gs = site.pages | where_exp: "p", "p.layout == 'guide'" | sort: "updated" | reverse %}{% for g in gs %}<item><title>{{ g.short | xml_escape }}</title><link>{{ site.url }}{{ g.url }}</link><guid>{{ site.url }}{{ g.url }}</guid><pubDate>{{ g.updated | date_to_rfc822 }}</pubDate><description>{{ g.description | xml_escape }}</description></item>
{% endfor %}</channel></rss>
